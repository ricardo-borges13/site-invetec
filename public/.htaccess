<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ==========================
  # CERTIFICADO SSL / ACME
  # ==========================

  RewriteRule ^\.well-known/acme-challenge/ - [L]

  # ==========================
  # REDIRECIONAMENTOS ANTIGOS
  # ==========================

  RewriteRule ^servicos/zimbra/?$ https://www.invetec.com.br/servicos/invetec-mail [R=301,L]

  RewriteRule ^servicos/email-corporativo-zimbra/?$ https://www.invetec.com.br/servicos/invetec-mail [R=301,L]

  RewriteRule ^servicos/invetec-mail-mei/?$ https://www.invetec.com.br/servicos/invetec-mail [R=301,L]

  RewriteRule ^prorata/?$ https://www.invetec.com.br/servicos/ferramentas-uteis/pro-rata [R=301,L]

  RewriteRule ^prorata/pro-rata/?$ https://www.invetec.com.br/servicos/ferramentas-uteis/pro-rata [R=301,L]

  RewriteRule ^prorata/calculadora-data/?$ https://www.invetec.com.br/servicos/ferramentas-uteis/calculadora-de-datas [R=301,L]

  # ==========================
  # DOMÍNIO CANÔNICO
  # ==========================

  RewriteCond %{HTTP_HOST} !^www\.invetec\.com\.br$ [NC]
  RewriteRule ^ https://www.invetec.com.br%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP:X-Forwarded-Proto} !^$ [NC]
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://www.invetec.com.br%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP:X-Forwarded-Proto} ^$
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.invetec.com.br%{REQUEST_URI} [R=301,L]

  # ==========================
  # PADRONIZAÇÃO DAS URLS
  # ==========================

  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://www.invetec.com.br/$1 [R=301,L]

  # ==========================
  # ARQUIVOS E DIRETÓRIOS REAIS
  # ==========================

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ==========================
  # ROTAS VÁLIDAS DO REACT
  # ==========================

  RewriteCond %{REQUEST_URI} ^/(sobre|contato|politica-de-privacidade|cases(?:/(datron|jpm))?|servicos/(erp(?:/(bling|w3erp))?|invetec-mail|criacao-de-sites|suporte-ti|e-commerce|cloud|ferramentas-uteis(?:/(pro-rata|calculadora-de-datas))?))/?$ [NC]
  RewriteRule ^ /index.html [L]

  # ==========================
  # PÁGINA 404
  # ==========================

  ErrorDocument 404 /index.html
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
